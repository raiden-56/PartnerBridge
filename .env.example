# ─── Application ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PartnerBridge

# ─── Local demo mode (no Supabase needed) ──────────────────────
# Set to 1 and leave the Supabase variables empty to run with an embedded
# database, fictional demo data and one-click guest mode. Local use only.
NEXT_PUBLIC_LOCAL_DEMO=0

# ─── Supabase (required unless NEXT_PUBLIC_LOCAL_DEMO=1) ─────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER prefix with NEXT_PUBLIC_ and never import into client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Optional OAuth providers (enable in Supabase Auth → Providers first) ──
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_AZURE_ENABLED=false

# ─── Razorpay (Indian subscriptions) ───────────────────────────
# Leave empty to run with payments disabled (checkout shows "not configured").
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Email (Resend). Leave empty to log emails to the server console. ──
RESEND_API_KEY=
EMAIL_FROM="PartnerBridge <notifications@your-domain.com>"

# ─── Web Push (generate with: npm run vapid) ───────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com

# ─── Optional e-signature provider (structure only; see docs/INTEGRATIONS.md) ──
ESIGN_PROVIDER=
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=

# ─── Cron (protects /api/cron/* endpoints) ─────────────────────
CRON_SECRET=change-me-to-a-long-random-string

# ─── Seed script ────────────────────────────────────────────────
SEED_DEMO_PASSWORD=Demo@PartnerBridge2026
